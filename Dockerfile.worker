FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    PYTHONPATH=/app/apps/api:/app/apps/worker:/app/packages/basketball-core/src

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY apps/worker/pyproject.toml ./apps/worker/pyproject.toml
COPY apps/mcp/pyproject.toml ./apps/mcp/pyproject.toml
COPY packages/basketball-core/pyproject.toml ./packages/basketball-core/pyproject.toml

RUN uv sync --frozen --package knicksiq-worker

COPY apps/api/app ./apps/api/app
COPY apps/worker/worker_app ./apps/worker/worker_app
COPY packages/basketball-core/src ./packages/basketball-core/src

RUN uv sync --frozen --package knicksiq-worker
RUN addgroup --system knicksiq && adduser --system --ingroup knicksiq knicksiq \
    && chown -R knicksiq:knicksiq /app
USER knicksiq

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["/app/.venv/bin/python", "-c", "import socket; from redis import Redis; from rq import Worker; raise SystemExit(not any(w.hostname == socket.gethostname() and w.pid == 1 for w in Worker.all(connection=Redis.from_url('redis://redis:6379/0'))))"]

CMD ["/app/.venv/bin/rq", "worker", "--url", "redis://redis:6379/0", "default"]

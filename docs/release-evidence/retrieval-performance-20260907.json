    {
      "source": "apps/api/app/services/rag.py:search_possession_chunks",
      "observation": "Legacy narrative fallback loads every matching event as an ORM entity, rebuilds possession chunks each request, then runs synchronous local ranking on the async event loop. Earlier broad queries ranked 31728 chunks, with lexical scoring 1312-1632 ms and total possession search 4125-4409 ms."
    },
    {
      "source": "apps/api/app/services/rag.py:_lexical_rank_chunks",
      "observation": "Per chunk JSON-serializes full metadata, tokenizes it plus chunk text, counts each query term by scanning the token list, and separately tokenizes player names. CPU work can delay unrelated concurrent requests; earlier get_games traces reached 4044-4082 ms despite other instances taking 2-47 ms. Event-loop blocking inference, not a measured DB execution plan."
    },
    {
      "source": "apps/api/app/services/releases.py:restrict_to_active_release",
      "observation": "Earlier non-production release bypass caused duplicate games/chunks. Current API agent fixed scope and V3 used the production-only restored database."
    }
